{
  "id": "jarvis-gilfoyle",
  "name": "Jarvis-Gilfoyle Project Board",
  "description": "A small project board in SQLite: projects, tasks with whose turn it is, notes, timed wake-ups for the product and engineering managers, and guaranteed messages to the project chat.",
  "contracts": { "tools": ["project_board"] },
  "skills": ["./skills"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["statePath", "productAgentId", "engineeringAgentId", "ownerChat", "worker"],
    "properties": {
      "statePath": { "type": "string" },
      "productAgentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
      "engineeringAgentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
      "sessionNamespace": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,31}$",
        "default": "jarvis-gilfoyle"
      },
      "enabled": { "type": "boolean" },
      "scanMs": { "type": "integer", "minimum": 10000, "maximum": 600000, "default": 60000 },
      "turnTimeoutSeconds": {
        "type": "integer",
        "minimum": 60,
        "maximum": 14400,
        "default": 1800,
        "description": "Timeout for one private task-session turn started by the board."
      },
      "maxWakesPerRole": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "default": 2,
        "description": "At most this many private task sessions per manager run at once."
      },
      "rewriteModel": {
        "type": "string",
        "minLength": 1,
        "description": "Model (provider/model) that rewrites project chat messages for the conversation. Omitted means the product manager's own model. Needs the entry's subagent.allowModelOverride."
      },
      "ownerChat": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "accountId", "to"],
        "description": "The owner's direct chat with the product manager: fallback for project messages.",
        "properties": {
          "channel": { "type": "string", "minLength": 1, "maxLength": 60 },
          "accountId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "to": { "type": "string", "minLength": 1, "maxLength": 240 },
          "threadId": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      },
      "worker": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agentId", "profiles"],
        "properties": {
          "agentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
          "runtime": { "type": "string", "enum": ["acp", "subagent"], "default": "acp" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 20, "default": 2 },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "model"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
                "model": { "type": "string", "minLength": 1, "maxLength": 160 },
                "thinking": {
                  "type": "string",
                  "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
                },
                "description": { "type": "string", "minLength": 1, "maxLength": 240 }
              }
            }
          }
        }
      }
    }
  }
}
